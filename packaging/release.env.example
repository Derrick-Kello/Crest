# Copy to packaging/release.env and fill in. That file is gitignored.
#
# Your 10 character Apple team id. Find it at
# developer.apple.com/account > Membership details > Team ID.
TEAM_ID=RA8Z6526CY

# Name of the notarytool keychain profile you created with
#   xcrun notarytool store-credentials diskpilot-notary \
#     --apple-id you@example.com --team-id XXXXXXXXXX
# Only the name goes here. The password stays in the keychain.
NOTARY_PROFILE=diskpilot-notary

# Signing identity. Leave as is unless you have several Developer ID certs
# and need to name one exactly as `security find-identity -v -p codesigning`
# prints it.
IDENTITY=Developer ID Application
